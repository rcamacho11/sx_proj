# Copy to .env. Never commit .env.
# Grok is optional: leave both empty and the drawing still works.
XAI_API_KEY=
GROK_MODEL=

# Optional overrides (defaults shown in docs/operations.md)
XAI_BASE_URL=
PLATE_WEB_PORT=8088
PLATE_PUBLIC_ORIGIN=http://localhost:8088
CHAT_DAILY_LIMIT=200
LOG_LEVEL=Information
LOG_CHAT_BODIES=false
