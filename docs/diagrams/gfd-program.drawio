<diagram id="gfd-program" name="Build program"><mxGraphModel dx="1200" dy="1660" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1660" math="0" shadow="0" background="#000000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Flow — ProgramBuilder.Build(part)" style="fontFamily=Barlow;text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;fontColor=#F0F0FA;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><mxCell id="legend" value="Legend: pill = start/end, rectangle = step, diamond = decision, parallelogram = input, document = output. Every decision labels both exits. Red = a skipped feature. Numbers are formatted invariant-culture, 3 decimals. Model text never enters this flow." style="fontFamily=Barlow;text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#CCCCCC;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1200" height="40" as="geometry"/></mxCell><mxCell id="s" value="Start" style="fontFamily=Barlow;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#171A20;strokeColor=#F0F0FA;fontColor=#F0F0FA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320.0" y="120" width="200" height="44" as="geometry"/></mxCell><mxCell id="in" value="Stored part (from SQLite, already valid)" style="fontFamily=Barlow;shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#000000;strokeColor=#F0F0FA;fontColor=#F0F0FA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240.0" y="190" width="360" height="50" as="geometry"/></mxCell><mxCell id="hdr" value="%  ·  (sanitized name)  ·  (TRAINING OUTPUT - DO NOT RUN ON A MACHINE)&lt;br&gt;(units, origin, stock, material, generator version)" style="fontFamily=Barlow;rounded=0;whiteSpace=wrap;html=1;fillColor=#171A20;strokeColor=#F0F0FA;fontColor=#F0F0FA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160.0" y="270" width="520" height="64" as="geometry"/></mxCell><mxCell id="modal" value="G21 G90 G17 G94  ·  G54" style="fontFamily=Barlow;rounded=0;whiteSpace=wrap;html=1;fillColor=#171A20;strokeColor=#F0F0FA;fontColor=#F0F0FA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240.0" y="360" width="360" height="44" as="geometry"/></mxCell><mxCell id="grp" value="Group holes by drill Ø (tap drill for threads), smallest first" style="fontFamily=Barlow;rounded=0;whiteSpace=wrap;html=1;fillColor=#171A20;strokeColor=#F0F0FA;fontColor=#F0F0FA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200.0" y="430" width="440" height="50" as="geometry"/></mxCell><mxCell id="dh" value="Next hole group?" style="fontFamily=Barlow;rhombus;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#F0F0FA;fontColor=#F0F0FA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320.0" y="510" width="200" height="90" as="geometry"/></mxCell><mxCell id="drill" value="T n M06 · S M03 · Z25 · G81 per hole, nearest-neighbour&lt;br&gt;Z = through ? −(t + 0.3D + 0.5) : −(depth + 0.3D)&lt;br&gt;G80 · Z25 · M05" style="fontFamily=Barlow;rounded=0;whiteSpace=wrap;html=1;fillColor=#171A20;strokeColor=#F0F0FA;fontColor=#F0F0FA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180.0" y="630" width="480" height="80" as="geometry"/></mxCell><mxCell id="dp" value="Next pocket or slot?" style="fontFamily=Barlow;rhombus;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#F0F0FA;fontColor=#F0F0FA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320.0" y="760" width="200" height="90" as="geometry"/></mxCell><mxCell id="pick" value="Largest end mill from 1–12 mm with&lt;br&gt;pocket: Ø ≤ 2R and ≤ short side · slot: Ø ≤ width" style="fontFamily=Barlow;rounded=0;whiteSpace=wrap;html=1;fillColor=#171A20;strokeColor=#F0F0FA;fontColor=#F0F0FA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200.0" y="880" width="440" height="60" as="geometry"/></mxCell><mxCell id="found" value="Tool found?" style="fontFamil