roToMany;" edge="1" parent="1" source="p1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="part_id" style="fontFamily=Barlow;labelBackgroundColor=#000000;html=1;edgeStyle=entityRelationEdgeStyle;endFill=0;startFill=0;strokeColor=#F0F0FA;fontColor=#F0F0FA;fontSize=12;startArrow=ERmandOne;endArrow=ERoneToMany;" edge="1" parent="1" source="p1" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="chat_message_id" style="fontFamily=Barlow;labelBackgroundColor=#000000;html=1;edgeStyle=entityRelationEdgeStyle;endFill=0;startFill=0;strokeColor=#F0F0FA;fontColor=#F0F0FA;fontSize=12;startArrow=ERzeroToOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="c1" target="r8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="idx" value="&lt;b&gt;Indexes&lt;/b&gt;&lt;br&gt;features (part_id, sort_order)&lt;br&gt;UNIQUE part_revisions (part_id, version)&lt;br&gt;chat_messages (part_id, created_at)&lt;br&gt;&lt;br&gt;&lt;b&gt;Pragmas&lt;/b&gt;&lt;br&gt;journal_mode=WAL · foreign_keys=ON · busy_timeout=5000&lt;br&gt;&lt;br&gt;&lt;b&gt;Retention&lt;/b&gt;&lt;br&gt;last 200 revisions per part" style="fontFamily=Barlow;text;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#171A20;strokeColor=#393C41;fontColor=#CCCCCC;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="420" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="erd-api" name="API shape"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0" background="#000000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Plate API shape — request and response bodies" style="fontFamily=Barlow;text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;fontColor=#F0F0FA;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><mxCell id="legend" value="Legend: boxes are JSON bodies, not tables. Every mutating request carries the version the client last saw. Every non-2xx response uses the error body." style="fontFamily=Barlow;text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#CCCCCC;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1200" height="40" as="geometry"/></mxCell><mxCell id="a1" value='POST /api/parts/{id}/actions&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;"name": "add_hole",&lt;br&gt;&amp;nbsp;&amp;nbsp;"args": { "x": 12, "y": 12, "thread": "M6", "through": true },&lt;br&gt;&amp;nbsp;&amp;nbsp;"version": 7&lt;br&gt;}&lt;br&gt;&lt;br&gt;200 → Part' style="fontFamily=Barlow;text;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#171A20;strokeColor=#393C41;fontColor=#F0F0FA;fontSize=12;fontFamily=Roboto Mono;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="600" height="170" as="geometry"/></mxCell><mxCell id="a2" value='Part&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;"id": "0193…",&lt;br&gt;&amp;nbsp;&amp;nbsp;"name": "PLATE-001",&lt;br&gt;&amp;nbsp;&amp;nbsp;"material": "6061-T6",&lt;br&gt;&amp;nbsp;&amp;nbsp;"length": 120, "width": 80, "thickness": 12,&lt;br&gt;&amp;nbsp;&amp;nbsp;"version": 8,&lt;br&gt;&amp;nbsp;&amp;nbsp;"updatedAt": "2026-11-13T21:04:00Z",&lt;br&gt;&amp;nbsp;&amp;nbsp;"features": [&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{ "id": "0193…", "type": "hole", "x": 12, "y": 12,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"through": true, "depth": 12, "diameter": 5.0, "thread": "M6" }&lt;br&gt;&amp;nbsp;&amp;nbsp;]&lt;br&gt;}' style="fontFamily=Barlow;text;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#171A20;strokeColor=#393C41;fontColor=#F0F0FA;fontSize=12;fontFamily=Roboto Mono;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="600" height="290" as="geometry"/></mxCell><mxCell id="a3" value='Error (4xx / 5xx)&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;"error": "Hole at (130, 40) is outside the 120 × 80 mm stock.",&lt;br&gt;&amp;nbsp;&amp;nbsp;"code": "outside_stock",&lt;br&gt;&amp;nbsp;&amp;nbsp;"field": "x",&lt;br&gt;&amp;nbsp;&amp;nbsp;"requestId": "0HN7…"&lt;br&gt;}' style="fontFamily=Barlow;text;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#171A20;strokeColor=#393C41;fontColor=#F0F0FA;fontSize=12;fontFamily=Roboto Mono;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="680" y="120" width="660" height="170" as="geometry"/></mxCell><mxCell id="a4" value='POST /api/parts/{id}/chat&amp;nbsp;&amp;nbsp;{ "message": "...", "version": 8 }&lt;br&gt;&lt;br&gt;200 (also 502 / 504 with partial trace)&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;"reply": "Added four M6 through holes …",&lt;br&gt;&amp;nbsp;&amp;nbsp;"trace": [&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{ "name": "add_corner_holes", "args": { "inset": 12, "thread": "M6" },&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"ok": true, "error": null, "code": null, "version": 9 }&lt;br&gt;&amp;nbsp;&amp;nbsp;],&lt;br&gt;&amp;nbsp;&amp;nbsp;"part": Part&lt;br&gt;}' style="fontFamily=Barlow;text;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#171A20;strokeColor=#393C41;fontColor=#F0F0FA;fontSize=12;fontFamily=Roboto Mono;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="680" y="310" width="660" height="290" as="geometry"/></mxCell><mxCell id="a5" value='GET /api/parts/{id}/program&lt;br&gt;{ "lines": ["%", "(PLATE-001)", …], "operations": [{ "n": 10, "kind": "drill", "tool": "T1 D5.000", "features": 4 }],&lt;br&gt;&amp;nbsp;&amp;nbsp;"issues": [{ "featureId": "…", "severity": "warning", "message": "Tap M6 is not in this file." }],&lt;br&gt;&amp;nbsp;&amp;nbsp;"runnable": true, "moves": [[x, y, z], …] }' style="fontFamily=Barlow;text;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#171A20;strokeColor=#393C41;fontColor=#F0F0FA;fontSize=12;fontFamily=Roboto Mono;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1300" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram>
