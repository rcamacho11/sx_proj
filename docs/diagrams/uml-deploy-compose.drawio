<mxfile host="app.diagrams.net" type="device">
<diagram id="uml-deploy" name="Compose deployment"><mxGraphModel dx="1500" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="820" math="0" shadow="0" background="#000000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Deployment — Docker Compose on one laptop" style="fontFamily=Barlow;text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;fontColor=#F0F0FA;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><mxCell id="legend" value="Legend: 3D box = node. Rounded box = container. Cylinder = volume. Document = file. Labels name the port or path. Lime = the only outbound call. Only web has a host port, bound to 127.0.0.1. api has no host port. .env reaches api only." style="fontFamily=Barlow;text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#CCCCCC;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1200" height="40" as="geometry"/></mxCell><mxCell id="host" value="«node» Laptop (macOS, Docker Desktop)" style="fontFamily=Barlow;shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=none;strokeColor=#393C41;fontColor=#8E939C;fontSize=13;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1100" height="640" as="geometry"/></mxCell><mxCell id="compose" value="«node» Compose project plate · network plate (bridge)" style="fontFamily=Barlow;shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=none;strokeColor=#CCCCCC;fontColor=#8E939C;fontSize=13;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="330" y="170" width="780" height="550" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;http://localhost:8088" style="fontFamily=Barlow;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#171A20;strokeColor=#F0F0FA;fontColor=#F0F0FA;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="80" y="260" width="200" height="80" as="geometry"/></mxCell><mxCell id="web" value="&lt;b&gt;web&lt;/b&gt;&lt;br&gt;host 127.0.0.1:8088 → :8080&lt;br&gt;nginx-unprivileged&lt;br&gt;read-only rootfs, cap_drop ALL&lt;br&gt;healthcheck /healthz" style="fontFamily=Barlow;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#171A20;strokeColor=#F0F0FA;fontColor=#F0F0FA;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="380" y="240" width="300" height="120" as="geometry"/></mxCell><mxCell id="apic" value="&lt;b&gt;api&lt;/b&gt;&lt;br&gt;ASP.NET Core, user app, listens :8080&lt;br&gt;read-only rootfs, tmpfs /tmp&lt;br&gt;healthcheck /health/ready&lt;br&gt;no host port" style="fontFamily=Barlow;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#171A20;strokeColor=#F0F0FA;fontColor=#F0F0FA;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="770" y="240" width="300" height="140" as="geometry"/></mxCell><mxCell id="vol" value="volume plate-data&lt;br&gt;/data/plate.db&lt;br&gt;/data/backups/" style="fontFamily=Barlow;shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#000000;strokeColor=#F0F0FA;fontColor=#F0F0FA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="520" width="160" height="110" as="geometry"/></mxCell><mxCell id="env" value=".env (gitignored)&lt;br&gt;XAI_API_KEY, GROK_MODEL" style="fontFamily=Barlow;shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.2;fillColor=#000000;strokeColor=#CCCCCC;fontColor=#CCCCCC;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="530" width="220" height="80" as="geometry"/></mxCell><mxCell id="xai2" value="api.x.ai&lt;br&gt;HTTPS :443" style="fontFamily=Barlow;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#75FBA6;fontColor=#F0F0FA;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="1220" y="270" width="180" height="80" as="geometry"/></mxCell><mxCell id="k1" value=":8088" style="fontFamily=Barlow;labelBackgroundColor=#000000;html=1;endArrow=block;endFill=1;strokeColor=#F0F0FA;fontColor=#F0F0FA;fontSize=12;verticalAlign=bottom;" edge="1" parent="1" source="browser" target="web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k2" value="/api/ → api:8080" style="fontFamily=Barlow;labelBackgroundColor=#000000;html=1;endArrow=block;endFill=1;strokeColor=#F0F0FA;fontColor=#F0F0FA;fontSize=12;verticalAlign=bottom;" edge="1" parent="1" source="web" target="apic"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k3" value="mount /data" style="fontFamily=Barlow;labelBackgroundColor=#000000;html=1;endArrow=block;endFill=1;strokeColor=#F0F0FA;fontColor=#F0F0FA;fontSize=12;verticalAlign=bottom;" edge="1" parent="1" source="apic" target="vol"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k4" value="env_file (api only)" style="fontFamily=Barlow;labelBackgroundColor=#000000;html=1;endArrow=open;endSize=10;dashed=1;strokeColor=#CCCCCC;fontColor=#CCCCCC;fontSize=12;" edge="1" parent="1" source="env" target="apic"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="570"/><mxPoint x="720" y="420"/><mxPoint x="840" y="420"/></Array></mxGeometry></mxCell><mxCell id="k5" value="egress HTTPS" style="fontFamily=Barlow;labelBackgroundColor=#000000;html=1;endArrow=block;endFill=1;strokeColor=#75FBA6;fontColor=#75FBA6;fontSize=12;verticalAlign=bottom;" edge="1" parent="1" source="apic" target="xai2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram>
